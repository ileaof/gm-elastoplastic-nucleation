mass         1 26.982
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
variable     cx equal (xlo+xhi)/2
variable     cy equal (ylo+yhi)/2
variable     cz equal (zlo+zhi)/2
region       rseed sphere $(v_cx) $(v_cy) $(v_cz) ${r0} units box
region       rseed sphere 49.294238576356697479 $(v_cy) $(v_cz) ${r0} units box
region       rseed sphere 49.294238576356697479 49.294238576356697479 $(v_cz) ${r0} units box
region       rseed sphere 49.294238576356697479 49.294238576356697479 49.294238576356697479 ${r0} units box
region       rseed sphere 49.294238576356697479 49.294238576356697479 49.294238576356697479 20.0 units box
group        sol region rseed
1961 atoms in group sol
group        liq subtract all sol
53335 atoms in group liq
variable     nseed0 equal count(sol)
print        "seed atoms N0 = $(v_nseed0)"
seed atoms N0 = 1961

# 3) melt and quench the surroundings with the seed frozen (zero pressure, liquid-only barostat)
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
velocity     liq create ${Tmelt} ${seed} mom yes rot yes dist gaussian
velocity     liq create 1500 ${seed} mom yes rot yes dist gaussian
velocity     liq create 1500 4928459 mom yes rot yes dist gaussian
fix          melt liq npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix          melt liq npt temp 1500 ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix          melt liq npt temp 1500 1500 0.2 iso 0.0 0.0 2.0 dilate liq
thermo_style custom step temp press vol pe
run          ${nmelt}
run          10000
