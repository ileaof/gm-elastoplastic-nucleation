mass         1 26.982
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
velocity     all create ${Tstar} ${seed} mom yes rot yes dist gaussian
velocity     all create 809.3 ${seed} mom yes rot yes dist gaussian
velocity     all create 809.3 4928459 mom yes rot yes dist gaussian
fix          lat all npt temp ${Tstar} ${Tstar} 0.2 iso 0.0 0.0 2.0
fix          lat all npt temp 809.3 ${Tstar} 0.2 iso 0.0 0.0 2.0
fix          lat all npt temp 809.3 809.3 0.2 iso 0.0 0.0 2.0
variable     alat equal lx/8
fix          aavg all ave/time 10 $(v_nlat/20) ${nlat} v_alat
fix          aavg all ave/time 10 250 ${nlat} v_alat
fix          aavg all ave/time 10 250 5000 v_alat
thermo       1000
run          ${nlat}
run          5000
