timestep     0.002
thermo_style custom step temp press pe pxy vol
thermo       500

# fase 1: subida blindada da temperatura (nenhum par ejeta)
velocity     all create 300.0 ${seed} mom yes rot no dist gaussian
velocity     all create 300.0 4928459 mom yes rot no dist gaussian
fix          nvel all nve/limit 5.0
fix          tRamp all temp/berendsen 300.0 ${T} 0.1
fix          tRamp all temp/berendsen 300.0 800 0.1
run          ${nrampe}
run          5000
