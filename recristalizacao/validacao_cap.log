unfix        nvel
unfix        tRamp
velocity     all scale ${T}
velocity     all scale 800

# fase 2: patamar NVT em T (producao)
fix          hold all nvt temp ${T} ${T} 0.1
fix          hold all nvt temp 800 ${T} 0.1
fix          hold all nvt temp 800 800 0.1
dump         d1 all custom 2000 recozido_${pot}_T${T}.dump id type x y z c_esp c_cnatmp
dump         d1 all custom 2000 recozido_jelinek_T${T}.dump id type x y z c_esp c_cnatmp
dump         d1 all custom 2000 recozido_jelinek_T800.dump id type x y z c_esp c_cnatmp
run          ${nprod}
run          1000
