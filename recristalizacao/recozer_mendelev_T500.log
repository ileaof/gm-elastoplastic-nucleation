# E6.2 — recozimento: um patamar de temperatura por chamada; a difusão ativa, a recristalização inicia
# Uso:  lmp -sf omp -pk omp 16 -in in.recozer.lmp -var pot jelinek -var alloy 1 -var datafile data_jelinek_0.14.data -var T 800
#   T: temperatura do patamar (abaixo de T_m = 936 ± 3 K do Jelinek);  série sugerida: 500 600 700 800 850 900
#   nrampe = passos da subida 300 K -> T (padrão 10000 = 20 ps);  nprod = passos no patamar (padrão 50000 = 100 ps)
# O termômetro da recristalização: queda de pe (além da recuperação) + fração CNA; dumps para o OVITO.
units        metal
atom_style   atomic
boundary     p p p

variable     pot      index jelinek
variable     alloy    index 1
variable     datafile index data_jelinek_0.14.data
variable     T        index 800
variable     nrampe   index 10000
variable     nprod    index 50000
variable     seed     index 4928459
variable     a0       equal 4.05
if "${pot} == mendelev" then "variable a0 equal 4.045"
variable a0 equal 4.045
variable     rc       equal 0.854*${a0}
variable     rc       equal 0.854*4.045

variable     ntypes equal 1
if "${pot} == jelinek && ${alloy} == 1" then "variable ntypes equal 4"

read_data    ${datafile}
read_data    data_mendelev_0.14.data
Reading data file ...
  triclinic box = (0 0 0) to (32.36 32.36 32.36) with tilt (4.5304 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  2048 atoms
  reading velocities ...
  2048 velocities
  read_data CPU = 0.020 seconds
include      pot_${pot}.lmp
include      pot_mendelev.lmp
# Mendelev, Kramer, Becker, Asta, Philos. Mag. 88 (2008) 1723 — EAM/FS Al puro (distribuição do LAMMPS)
# T_m = 932,3 K no e2 (coexistência). Só Al (ntypes = 1).
pair_style eam/fs
pair_coeff * * ./potencias/Al_Mendelev2008/Al_mm.eam.fs Al
Reading eam/fs potential file ./potencias/Al_Mendelev2008/Al_mm.eam.fs with DATE: 2007-06-11

# protecao contra 'lost atoms': minimiza as sobreposicoes residuais da configuracao
# deformada e acompanha os vizinhos passo a passo (o evento de 700 K vem daqui)
min_style    cg
minimize     1.0e-10 1.0e-10 5000 200000
