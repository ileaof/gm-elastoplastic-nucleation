package gpu 0
# E6.6 — controle FCC puro (62 500 átomos, mesmos computes/CNA), recozimento NPT (P = 0) de 1 ns:
# a régua de referência das corridas descarregadas+NPT (as NVT têm a régua do ctrl_fcc ja medida).
# Variáveis: -var T2 <T> -var seed <s>
units        metal
atom_style   atomic
boundary     p p p

variable     nx     index 25
variable     T2     index 900
variable     seed   index 91
variable     nprod  index 500000
variable     DF     index 25000
variable     a0     equal 4.045
variable     rc     equal 0.854*${a0}
variable     rc     equal 0.854*4.045

lattice      fcc ${a0}
lattice      fcc 4.045
Lattice spacing in x,y,z = 4.045 4.045 4.045
region       box block 0 ${nx} 0 ${nx} 0 ${nx}
region       box block 0 25 0 ${nx} 0 ${nx}
region       box block 0 25 0 25 0 ${nx}
region       box block 0 25 0 25 0 25
create_box   1 box
Created orthogonal box = (0 0 0) to (101.125 101.125 101.125)
  1 by 1 by 1 MPI processor grid
change_box   all triclinic
Changing box ...
  triclinic box = (0 0 0) to (101.125 101.125 101.125) with tilt (0 0 0)
create_atoms 1 box
Created 62500 atoms
  using lattice units in triclinic box = (0 0 0) to (101.125 101.125 101.125) with tilt (0 0 0)
  create_atoms CPU = 0.003 seconds
mass         1 26.982
include      pot_mendelev.lmp
# Mendelev, Kramer, Becker, Asta, Philos. Mag. 88 (2008) 1723 — EAM/FS Al puro (distribuição do LAMMPS)
# T_m = 932,3 K no e2 (coexistência). Só Al (ntypes = 1).
pair_style eam/fs
pair_coeff * * ./potencias/Al_Mendelev2008/Al_mm.eam.fs Al
Reading eam/fs potential file ./potencias/Al_Mendelev2008/Al_mm.eam.fs with DATE: 2007-06-11

compute      esp all pe/atom
compute      cnatmp all cna/atom ${rc}
compute      cnatmp all cna/atom 3.45443

velocity     all create 300.0 ${seed} mom yes rot no dist gaussian
velocity     all create 300.0 91 mom yes rot no dist gaussian
timestep     0.002
thermo_style custom step temp press pe pxy vol
thermo       1000

fix          e1 all nvt temp 300.0 300.0 0.1
run          5000

