compute      esp all pe/atom
compute      cnatmp all cna/atom ${rc}
compute      cnatmp all cna/atom 3.4587

timestep     0.002
thermo_style custom step temp press pe pxy vol
thermo       500

# subida 300 K -> T (20 ps por padrão), depois patamar em T (100 ps por padrão)
velocity     all create 300.0 ${seed} mom yes rot no dist gaussian
velocity     all create 300.0 33775 mom yes rot no dist gaussian
fix          ramp all nvt temp 300.0 ${T} 0.1
fix          ramp all nvt temp 300.0 775 0.1
run          ${nrampe}
run          10000
