# E6.2 — recozimento: um patamar de temperatura por chamada; a difusão ativa, a recristalização inicia
# Uso:  lmp -sf omp -pk omp 16 -in in.recozer.lmp -var pot jelinek -var alloy 1 -var datafile data_jelinek_0.14.data -var T 800
#   T: temperatura do patamar (abaixo de T_m = 936 ± 3 K do Jelinek);  série sugerida: 500 600 700 800 850 900
#   nrampe = passos da subida 300 K -> T (padrão 10000 = 20 ps);  nprod = passos no patamar (padrão 50000 = 100 ps)
# O termômetro da recristalização: queda de pe (além da recuperação) + fração CNA; dumps para o OVITO.
units        metal
atom_style   atomic
boundary     p p p

variable     pot      index jelinek
variable     alloy    index 1
variable     datafile index data_jelinek_0.14.data
variable     T        index 800
variable     nrampe   index 10000
variable     nprod    index 50000
variable     seed     index 4928459
variable     a0       equal 4.05
if "${pot} == mendelev" then "variable a0 equal 4.045"
variable     rc       equal 0.854*${a0}
variable     rc       equal 0.854*4.05

variable     ntypes equal 1
if "${pot} == jelinek && ${alloy} == 1" then "variable ntypes equal 4"
variable ntypes equal 4

read_data    ${datafile}
read_data    data_jelinek_0.14.data
Reading data file ...
  triclinic box = (0 0 0) to (32.4 32.4 32.4) with tilt (4.536 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  2048 atoms
  reading velocities ...
  2048 velocities
  read_data CPU = 0.027 seconds
include      pot_${pot}.lmp
include      pot_jelinek.lmp
# Jelinek et al., Phys. Rev. B 85 (2012) 245102 — MEAM Al-Si-Mg-Cu-Fe (distribuição do LAMMPS)
# ntypes = 1: Al puro na família Jelinek; ntypes = 4: liga Al-Si-Mg-Fe (ordem dos tipos: Al, Si, Mg, Fe)
if "${ntypes} == 1" then "pair_style meam" "pair_coeff * * ./potencias/AlSiMgCuFe_Jelinek2012/library.meam AlS SiS MgS CuS FeS ./potencias/AlSiMgCuFe_Jelinek2012/AlSiMgCuFe.meam AlS"
if "${ntypes} == 4" then "pair_style meam" "pair_coeff * * ./potencias/AlSiMgCuFe_Jelinek2012/library.meam AlS SiS MgS CuS FeS ./potencias/AlSiMgCuFe_Jelinek2012/AlSiMgCuFe.meam AlS SiS MgS FeS"
pair_style meam
pair_coeff * * ./potencias/AlSiMgCuFe_Jelinek2012/library.meam AlS SiS MgS CuS FeS ./potencias/AlSiMgCuFe_Jelinek2012/AlSiMgCuFe.meam AlS SiS MgS FeS
Reading MEAM library file ./potencias/AlSiMgCuFe_Jelinek2012/library.meam with DATE: 2012-06-29
Reading MEAM potential file ./potencias/AlSiMgCuFe_Jelinek2012/AlSiMgCuFe.meam with DATE: 2012-06-29

# protecao contra 'lost atoms': minimiza as sobreposicoes residuais da configuracao
# deformada e acompanha os vizinhos passo a passo (o evento de 700 K vem daqui)
min_style    cg
minimize     1.0e-10 1.0e-10 5000 200000
