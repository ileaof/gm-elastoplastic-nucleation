# E6.6 — controle FCC puro (62 500 átomos, mesmos computes/CNA), recozimento NPT (P = 0) de 1 ns:
# a régua de referência das corridas descarregadas+NPT (as NVT têm a régua do ctrl_fcc ja medida).
# Variáveis: -var T2 <T> -var seed <s>
units        metal
atom_style   atomic
boundary     p p p

variable     nx     index 25
variable     T2     index 900
variable     seed   index 91
variable     nprod  index 500000
variable     DF     index 25000
variable     a0     equal 4.045
variable     rc     equal 0.854*${a0}

lattice      fcc ${a0}
region       box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box   1 box
change_box   all triclinic
create_atoms 1 box
mass         1 26.982
include      pot_mendelev.lmp

compute      esp all pe/atom
compute      cnatmp all cna/atom ${rc}

velocity     all create 300.0 ${seed} mom yes rot no dist gaussian
timestep     0.002
thermo_style custom step temp press pe pxy vol
thermo       1000

fix          e1 all nvt temp 300.0 300.0 0.1
run          5000
unfix        e1

# frame de reference a 300 K
dump         d0 all custom 1 ctrl_npt_T${T2}_300.dump id type x y z c_esp c_cnatmp
dump_modify  d0 sort id
run          1
undump       d0

fix          ramp all npt temp 300.0 ${T2} 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 z 0.0 0.0 1.0
run          5000
unfix        ramp

fix          an all npt temp ${T2} ${T2} 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 z 0.0 0.0 1.0
dump         d1 all custom 1 ctrl_npt_T${T2}_hold0.dump id type x y z c_esp c_cnatmp
dump_modify  d1 sort id
run          1
undump       d1
run          20000
dump         d2 all custom 1 ctrl_npt_T${T2}_late.dump id type x y z c_esp c_cnatmp
dump_modify  d2 sort id
run          1
undump       d2

# 1 ns de hold NPT com dumps
dump         d3 all custom ${DF} ctrl_npt_T${T2}_traj.dump id type x y z c_esp c_cnatmp
run          ${nprod}
print        "E6.6-controle NPT em ${T2} K completa"