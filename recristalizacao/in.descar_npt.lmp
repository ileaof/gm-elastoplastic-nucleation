# E6.6 — célula grande do Mendelev (62 500 átomos, EAM + -sf gpu):
# 1) FCC; 2) equilíbrio 300 K; 3) cisalhamento em linha até gam (erate 0.010/ps);
# 4) DESCARREGAMENTO reverso em degraus até pxy >= 0 (protocolo E6.4); 5) rampa NPT 300->T2;
# 6) recozimento NPT (P = 0) de 1 ns com dumps a cada 25 000 passos.
# Variáveis por linha de comando: -var T2 <T> -var seed <s> -var gam <0.10|0.30>
units        metal
atom_style   atomic
boundary     p p p

variable     gam    index 0.10
variable     nx     index 25
variable     T2     index 900
variable     seed   index 91
variable     nprod  index 500000
variable     DF     index 25000
variable     a0     equal 4.045
variable     rc     equal 0.854*${a0}
variable     nsh    equal 50000*${gam}

lattice      fcc ${a0}
region       box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box   1 box
change_box   all triclinic
create_atoms 1 box
mass         1 26.982
include      pot_mendelev.lmp

compute      esp all pe/atom
compute      cnatmp all cna/atom ${rc}

velocity     all create 300.0 ${seed} mom yes rot no dist gaussian
timestep     0.002
thermo_style custom step temp press pe pxy vol
thermo       1000

fix          e1 all nvt temp 300.0 300.0 0.1
run          5000
unfix        e1
fix          e2 all nvt temp 300.0 300.0 0.1
fix          sh all deform 1 xy erate 0.010 remap v
run          ${nsh}
unfix        sh
unfix        e2

# ---- descarregamento elástico: reverso em degraus de 100 passos até o pxy cruzar zero
variable     pnow equal pxy
variable     i loop 200
label        loop_desc
fix          dv all nvt temp 300.0 300.0 0.1
fix          de all deform 1 xy erate -0.010 remap v
run          100
unfix        de
unfix        dv
if "${pnow} >= 0.0" then "jump SELF fim_desc"
next         i
jump         SELF loop_desc
label        fim_desc
print        "DESCA_CROSS step=$(step) pxy=$(pxy) PE=$(pe) eps=${gam}"

# ---- relaxamento no estado descarregado e rampa a barra zero (NPT)
fix          e3 all nvt temp 300.0 300.0 0.1
run          2000
unfix        e3
fix          rr all npt temp 300.0 ${T2} 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 z 0.0 0.0 1.0
run          5000
unfix        rr

# ---- recozimento NPT (P = 0) de 1 ns
fix          an all npt temp ${T2} ${T2} 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 z 0.0 0.0 1.0
dump         d1 all custom ${DF} reciz_descarnpt_T${T2}_g${gam}_s${seed}.dump id type x y z c_esp c_cnatmp
run          ${nprod}
print        "E6.6 completa: reciz_descarnpt_T${T2}_g${gam}_s${seed}.dump"